# Copy to .env and fill in. Never commit .env.

# Where submission emails are delivered (default is rc.ryanjones@gmail.com if omitted)
MAIL_TO=rc.ryanjones@gmail.com

# Gmail: use a Google "App password" (2FA required), not your normal password
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Usually same as SMTP_USER for Gmail
SMTP_FROM=you@gmail.com

# Defaults work for Gmail; for port 587 use: SMTP_PORT=587 SMTP_SECURE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
